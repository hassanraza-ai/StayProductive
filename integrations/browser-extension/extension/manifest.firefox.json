{
  "manifest_version": 3,
  "name": "StayProductive",
  "version": "0.1.0",
  "description": "Local-only site and keyword blocking that follows the profiles in your StayProductive daemon.",
  "permissions": ["nativeMessaging", "declarativeNetRequest", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["lib/policy.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/blockpage.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "blocked.css", "blocked.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "StayProductive"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "stayproductive@local",
      "strict_min_version": "128.0"
    }
  }
}
